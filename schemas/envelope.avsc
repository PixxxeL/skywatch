{
  "type": "record",
  "name": "Envelope",
  "namespace": "skywatch",
  "doc": "Common envelope for all messages in the internal topics. Envelope fields are the same for every source; source-specific data is serialized inside payload.",
  "fields": [
    {"name": "source", "type": "string", "doc": "ztf | gcn | noaa | ..."},
    {"name": "event_type", "type": "string", "doc": "alert | notice | ..."},
    {"name": "event_id", "type": "string", "doc": "unique event ID assigned by the source"},
    {"name": "event_ts", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "ingest_ts", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "schema_version", "type": "int", "doc": "payload schema version"},
    {"name": "payload", "type": "bytes", "doc": "event body, Avro per <source>_<type>_lite.avsc schema"}
  ]
}
