# === Infrastructure (used by docker-compose in the VM/VDS) ===

# Address at which code running on the HOST reaches Kafka in the VM.
# Dev: 127.0.0.1 — works through VM port forwarding.
# Prod (VDS): server IP/hostname, or 127.0.0.1 if services talk only inside the docker network.
KAFKA_EXTERNAL_HOST=127.0.0.1
KAFKA_EXTERNAL_PORT=29092

CLICKHOUSE_USER=skywatch
CLICKHOUSE_PASSWORD=change-me

# GitHub username (lowercase) — owner of the ghcr.io images
# (used by docker-compose.registry.yml)
GHCR_OWNER=

# === Python services settings (copy to the repo-root .env on the dev host) ===

KAFKA_BOOTSTRAP=127.0.0.1:29092
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DB=skywatch

# Source mode: synthetic | replay | fink
SOURCE_MODE=synthetic
# synthetic: messages per second
SYNTHETIC_RATE=5
# replay: directory with .avro files from ZTF nightly archives
DATA_DIR=./data/ztf
REPLAY_RATE=50

# fink: credentials after registering with fink_client_register
FINK_USERNAME=
FINK_GROUP_ID=
FINK_SERVERS=kafka-ztf.fink-broker.org:24499
FINK_TOPICS=fink_sso_ztf_candidates_ztf

# Consumer
BATCH_SIZE=500
BATCH_TIMEOUT_S=2.0
