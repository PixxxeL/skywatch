# === Инфраструктура (используется docker-compose в VM/VDS) ===

# Адрес, по которому код на ХОСТЕ достучится до Kafka в VM.
# Dev: 127.0.0.1 — работает через проброс портов NAT-адаптера VirtualBox (см. README).
# Prod (VDS): IP/имя сервера либо 127.0.0.1, если сервисы ходят только внутри docker-сети.
KAFKA_EXTERNAL_HOST=127.0.0.1
KAFKA_EXTERNAL_PORT=29092

CLICKHOUSE_USER=skywatch
CLICKHOUSE_PASSWORD=change-me

# === Настройки Python-сервисов (копируется в корневой .env на Windows-хосте) ===

KAFKA_BOOTSTRAP=127.0.0.1:29092
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DB=skywatch

# Режим источника: synthetic | replay | fink
SOURCE_MODE=synthetic
# synthetic: сообщений в секунду
SYNTHETIC_RATE=5
# replay: каталог с .avro файлами ночных архивов ZTF
DATA_DIR=./data/ztf
REPLAY_RATE=50

# fink: креды после регистрации fink_client_register
FINK_USERNAME=
FINK_GROUP_ID=
FINK_SERVERS=kafka-ztf.fink-broker.org:24499
FINK_TOPICS=fink_sso_ztf_candidates_ztf

# Консьюмер
BATCH_SIZE=500
BATCH_TIMEOUT_S=2.0
